output = NodePath("../../DialogueBox/DialogueText")
Lines = Array[String](["I hope you're feeling better today, Amy.", "It's very difficult to get over this, I know.", "But know that when you wake up I will be here for you.", "And I will do everything to help.", "...", "We're all waiting for you, you know?", "Especially Cream, she keeps asking me about you.", "But I don't have the courage to tell her the truth yet.", "I wish I could know what happened to you in that place.", "And I'd also like to know what made you want to come back.", "...", "Please... be strong, and come back to us.", "Now I have to go back to the Master Emerald.", "I'll be back the day after tomorrow.", "See you next time, okay? Rest well.", "...", "..."])
