offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "To navigate around your office, you’ll need to click on one of the
entrances. You’ll be able to go to the vents, the hallway, the
ceiling, and finally under the desk. At each entrance (except
for the desk), you can use the flashlight by holding down
[Ctrl]. Only in the vents, however, can you use the
mask by pressing [Shift]

If you hear a radio, go to the ceiling and shine the
flashlight on it until the danger goes away.

If you hear someone coming from the vents and they’re
green, use the mask; if they’re red, look at their eyes; if
they can see you, use the mask; if they can’t see you,
hide under the desk."
horizontal_alignment = 1
metadata/_edit_lock_ = true

[node name="Text2" type="Label" parent="GUIWorld" unique_id=1946421797]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.55
anchor_right = 0.5
anchor_bottom = 0.55
offset_left = -576.0
offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "The blue guys aren't fooled by the mask. If one
of them dares to attack you from the vents,
hide under the desk.

A mushroom has also just sprouted tonight; if you
hear its laughter coming from the left vent, turn
your flashlight on and off repeatedly until it
leaves you alone.

Otherwise, everything else is the same.
Good luck."
horizontal_alignment = 1
metadata/_edit_lock_ = true

[node name="Text3" type="Label" parent="GUIWorld" unique_id=165184980]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.55
anchor_right = 0.5
anchor_bottom = 0.55
offset_left = -576.0
offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "That other blue guy will try to slowly approach
your position from the hallway. You can keep an
eye on him via the monitor above your desk; if
you hear him laughing, shine your flashlight
on him until he goes away.

You're close to the truth, Amy."
horizontal_alignment = 1
metadata/_edit_lock_ = true

[node name="Text4" type="Label" parent="GUIWorld" unique_id=277056774]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.55
anchor_right = 0.5
anchor_bottom = 0.55
offset_left = -576.0
offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "An old acquaintance of yours will be joining us tonight.
She won't be very dangerous, but if she tries to attack
you, hide under the desk. Nothing too complicated."
horizontal_alignment = 1
metadata/_edit_lock_ = true

[node name="Text5" type="Label" parent="GUIWorld" unique_id=579748196]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.55
anchor_right = 0.5
anchor_bottom = 0.55
offset_left = -576.0
offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "Everyone you've met so far will be more aggressive
tonight, but not for long... Things are going to
change, and when they do, keep this in mind:

from the vents to the mask,
from the hallway to the desk,
from the ceiling to the flashlight.

It's time to shine."
horizontal_alignment = 1
metadata/_edit_lock_ = true

[node name="Text6" type="Label" parent="GUIWorld" unique_id=307362197]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.55
anchor_right = 0.5
anchor_bottom = 0.55
offset_left = -576.0
offset_top = -284.0
offset_right = 576.0
offset_bottom = 284.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 32
text = "You're outside the pizzeria, wanting to get some fresh air,
but there's a lot of trash outside, and you might also notice
that the world looks different from how it did last night...
You don't have time to think about that right now; in this
mini-game, you'll encounter a hedgehog and a fox. To win,
you'll have to chase those two creatures a set number
of times within a set time limit. Always keep your flashlight
off. When you hear little footsteps, if you find the fox, you’ll
need to turn the flashlight off and on until it goes away; if you
find the hedgehog, you’ll need to shine the flashlight
directly at it."
horizontal_alignment = 1
metadata/_edit_lock_ = true

